{
	"schemaVersion": 1,
	"meta": {
		"id": "my-opencode-tps-tui1",
		"description": "规则组合 [G4] 的提交信息配置"
	},
	"commitMessage": {
		"line": {
			"mode": "single",
			"maxLength": 200
		},
		"standardPrefix": {
			"mode": "auto",
			"patterns": []
		},
		"device": {
			"required": false,
			"whitelist": [],
			"sources": [
				".git/info/device-name.txt",
				"hostname"
			]
		},
		"examples": [
			"2026-11-05-CHORE-把[.githooks/commit-msg]钩子注释与[echo]字符串里的全角圆括号改为半角，按[A0907]口径清理[4]处残留并删去随之产生的行尾空白，改动只涉及注释与提示文案的文本形态，参数拼接与退出码透传逻辑一字未动"
		],
		"instructions": {
			"punctuation": [
				"中文语句用全角标点，西文语句用半角标点，同一语句内不混用。",
				"非引用部分把 `【】 〖〗 『』 「」` 替换为半角方括号 `[]`。",
				"中文与西文的相邻边界用半角方括号 `[]` 括含。",
				"除固定词组之外，尽量不要出现空格，用包含同样分隔意义的斜杠 `/`、反斜杠 `\\`、全角顿号 `、`、全角逗号 `，`、竖线 `|` 等符号代替"
			],
			"purpose": [
				"前两句简明扼要、精准概括地说清本次提交要达成的目的，不要罗列细节，概括部分是必需的，至少要有一句话。",
				"后续内容为细节描述部分，在其中再说清大致改了哪些内容，细节描述部分非必需。"
			],
			"structure": [
				"概括部分与细节描述部分之间的间隔要清晰。",
				"不得出现用于分层的句号 `。` 与分号 `；`，需要分层时用半角圆括号 `()` 括含或改用列表前缀。"
			]
		}
	},
	"gate": {
		"command": "python E:/vscode-workspace-temp/tools/check_commit_msg.py --check --file {file} --repo {repo}",
		"passCodes": [
			0
		],
		"passPattern": ""
	},
	"notes": [
		"本仓属于规则组合 [G4]，典型提交格式：`日期-TYPE-正文`。",
		"TYPE 为全大写英文字母，可带数字与下划线，长度小于等于 [10]，例如 `CHORE`、`FEAT`、`DOCS`。",
		"TYPE 不是固定枚举，按本次改动性质取名即可，同一含义尽量沿用同一写法。"
	]
}
