{
	"name": "my-opencode-tps-tui1",
	"version": "1.1.0",
	"description": "TPS / 词元 / 时延 HUD，渲染在 OpenCode 1.x TUI 的会话提示行右侧",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./tui.tsx",
		"./tui": "./tui.tsx",
		"./package.json": "./package.json"
	},
	"files": [
		"tui.tsx",
		"src",
		"README.md"
	],
	"scripts": {
		"selftest": "bun run scripts/selftest.ts",
		"loadtest": "bun run scripts/loadtest.ts",
		"check-deps": "bun run scripts/check-deps.ts",
		"probe": "bun run scripts/probe.ts"
	},
	"keywords": [
