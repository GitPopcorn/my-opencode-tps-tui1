		"opencode-plugin",
		"tui",
		"tps",
		"tokens-per-second",
		"ttft"
	],
	"engines": {
		"opencode": ">=1.18",
		"bun": ">=1.0.0"
	},
	"devDependencies": {
		"@opencode-ai/plugin": "1.18.25",
		"@opentui/core": "0.5.8",
		"@opentui/solid": "0.5.8",
		"@types/node": "^22.20.2",
		"solid-js": "1.9.12",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"msgpackr-extract@3.0.4": true
	}
}
