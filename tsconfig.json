{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": []
	},
	"include": [
		"tui.tsx",
		"src/**/*.ts",
		"scripts/**/*.ts"
	]
}
